@PACKAGE_INIT@

# Boost: its own BoostConfig.cmake, as in the build of gbs (CMP0167). This file has its own policy
# scope; the policy is set before CMakeFindDependencyMacro, whose macros keep the policies in
# effect where they are defined.
if(POLICY CMP0167)
    cmake_policy(SET CMP0167 NEW)
endif()

include(CMakeFindDependencyMacro)

find_dependency(Eigen3)
find_dependency(Boost)
find_dependency(libIGES)

if(UNIX)
    find_dependency(TBB)
endif()

include("${CMAKE_CURRENT_LIST_DIR}/GBSTargets.cmake")

if(@GBS_USE_RENDER@)
    find_dependency(VTK QUIET COMPONENTS
        CommonCore
        CommonColor
        CommonDataModel
        FiltersSources
        FiltersGeneral
        InteractionStyle
        InteractionWidgets
        RenderingCore
        RenderingFreeType
        RenderingOpenGL2
        RenderingAnnotation
        ChartsCore
        RenderingContext2D
        RenderingContextOpenGL2
        ViewsContext2D
        RenderingGL2PSOpenGL2
        IOXML
        PythonInterpreter
        WrappingPythonCore
    )
    # -utf-8 of VTK::fmt for MSVC only, as in the build of gbs
    include("${CMAKE_CURRENT_LIST_DIR}/GbsVtkFmt.cmake")
endif()

if(@GBS_USE_OCCT_UTILS@)
    find_dependency(OpenCASCADE QUIET)
endif()
